{
  "apiVersion": "1.0",
  "indexBase": 0,
  "expected": {
    "type": "object",
    "properties": {
      "documentId": {
        "type": "string",
        "maxLength": 300
      },
      "revision": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100000
      }
    },
    "required": [
      "documentId",
      "revision"
    ],
    "additionalProperties": false
  },
  "commands": {
    "elements.read": {
      "summary": "读取当前页元素详情、文字片段、计算样式与画布坐标；样式只作用于目标元素，SVG 填色/描边作用于其图形",
      "parameters": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          }
        },
        "required": [
          "ids"
        ],
        "additionalProperties": false
      }
    },
    "elements.select": {
      "summary": "选中当前页图层，联动定位左侧列表",
      "write": true,
      "parameters": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          }
        },
        "required": [
          "ids"
        ],
        "additionalProperties": false
      }
    },
    "elements.text": {
      "summary": "批量修改文字。每项使用 text 或 runs 二选一；富文本多片段必须按 elements.read 返回的 runs.index 修改，保留标签样式。表格/图表数据使用 charts 工具",
      "write": true,
      "parameters": {
        "type": "object",
        "properties": {
          "edits": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "text": {
                  "type": "string",
                  "maxLength": 20000
                },
                "runs": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 300,
                  "items": {
                    "type": "object",
                    "properties": {
                      "index": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9999
                      },
                      "text": {
                        "type": "string",
                        "maxLength": 20000
                      }
                    },
                    "required": [
                      "index",
                      "text"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "id"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "edits"
        ],
        "additionalProperties": false
      }
    },
    "elements.style": {
      "summary": "批量设置字体、颜色、填充、描边、阴影、透明度等。尺寸单位 px；opacity 为 0–100；rotate 为角度；background 支持无外链的简单渐变",
      "write": true,
      "parameters": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          },
          "styles": {
            "type": "object",
            "properties": {
              "fontFamily": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "fontSize": {
                "type": "number",
                "minimum": 1,
                "maximum": 1000
              },
              "fontWeight": {
                "type": "string",
                "enum": [
                  "100",
                  "200",
                  "300",
                  "400",
                  "500",
                  "600",
                  "700",
                  "800",
                  "900",
                  "normal",
                  "bold"
                ]
              },
              "fontStyle": {
                "type": "string",
                "enum": [
                  "normal",
                  "italic",
                  "oblique"
                ]
              },
              "color": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "lineHeight": {
                "type": "number",
                "minimum": 0,
                "maximum": 2000
              },
              "letterSpacing": {
                "type": "number",
                "minimum": -100,
                "maximum": 1000
              },
              "textAlign": {
                "type": "string",
                "enum": [
                  "left",
                  "center",
                  "right",
                  "justify",
                  "start",
                  "end"
                ]
              },
              "textDecoration": {
                "type": "string",
                "enum": [
                  "none",
                  "underline",
                  "line-through",
                  "overline"
                ]
              },
              "fill": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "background": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "stroke": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "strokeWidth": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000
              },
              "strokeStyle": {
                "type": "string",
                "enum": [
                  "none",
                  "solid",
                  "dashed",
                  "dotted",
                  "double"
                ]
              },
              "radius": {
                "type": "number",
                "minimum": 0,
                "maximum": 24000
              },
              "opacity": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "boxShadow": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "rotate": {
                "type": "number",
                "minimum": -36000,
                "maximum": 36000
              }
            },
            "required": [],
            "additionalProperties": false
          }
        },
        "required": [
          "ids",
          "styles"
        ],
        "additionalProperties": false
      }
    },
    "elements.geometry": {
      "summary": "批量设置位置和尺寸。x/y 为画布坐标，width/height 为局部边框尺寸 px。geometry:{fitContent:true} 将容器宽高贴合内容、移除四周空白和内边距、保留内部尺寸间距；不能与 x/y/width/height 混用。如返回 CONFIRMATION_REQUIRED，须先获用户同意再传 acceptLayoutChange:true。流式元素自由移动须先转换容器布局",
      "write": true,
      "parameters": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          },
          "geometry": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "minimum": -100000,
                "maximum": 100000
              },
              "y": {
                "type": "number",
                "minimum": -100000,
                "maximum": 100000
              },
              "width": {
                "type": "number",
                "minimum": 1,
                "maximum": 24000
              },
              "height": {
                "type": "number",
                "minimum": 1,
                "maximum": 24000
              },
              "fitContent": {
                "type": "boolean"
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "acceptLayoutChange": {
            "type": "boolean"
          }
        },
        "required": [
          "ids",
          "geometry"
        ],
        "additionalProperties": false
      }
    },
    "elements.layout": {
      "summary": "设置 HTML 容器的 Flex/Grid/自由布局及间距内边距。转换 free 固定当前视口、改变响应式行为，必须先向用户说明并获同意后传 acceptLayoutChange:true",
      "write": true,
      "parameters": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "layout": {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "flex",
                  "grid",
                  "free"
                ]
              },
              "direction": {
                "type": "string",
                "enum": [
                  "row",
                  "column",
                  "row-reverse",
                  "column-reverse"
                ]
              },
              "gap": {
                "type": "number",
                "minimum": 0,
                "maximum": 2000
              },
              "padding": {
                "type": "number",
                "minimum": 0,
                "maximum": 2000
              },
              "align": {
                "type": "string",
                "enum": [
                  "stretch",
                  "flex-start",
                  "center",
                  "flex-end",
                  "baseline"
                ]
              },
              "justify": {
                "type": "string",
                "enum": [
                  "flex-start",
                  "center",
                  "flex-end",
                  "space-between",
                  "space-around",
                  "space-evenly"
                ]
              },
              "wrap": {
                "type": "string",
                "enum": [
                  "nowrap",
                  "wrap",
                  "wrap-reverse"
                ]
              },
              "columns": {
                "type": "integer",
                "minimum": 1,
                "maximum": 24
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "acceptLayoutChange": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "layout"
        ],
        "additionalProperties": false
      }
    },
